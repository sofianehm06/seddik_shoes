<%- include('partials/head', { description: product.description.slice(0, 160) }) %>
<%
  const promo = product.old_price && product.old_price > product.price;
  const sizeLabel = product.category === 'accessoires' ? 'Taille' : 'Pointure';
  const minDesk = Math.min(config.delivery.deskFee, ...Object.values(config.delivery.overrides).map(o => o.desk ?? config.delivery.deskFee));
%>
<div class="container section">
  <nav class="breadcrumb">
    <a href="/">Accueil</a> <%- icon('right') %>
    <a href="/boutique?genre=<%= product.gender %>"><%= label(config.genders, product.gender) %></a> <%- icon('right') %>
    <a href="/boutique?genre=<%= product.gender %>&type=<%= product.category %>"><%= label(config.categories, product.category) %></a> <%- icon('right') %>
    <span><%= product.name %></span>
  </nav>

  <div class="product" style="margin-top:1rem">
    <div class="gallery<%= product.images.length > 1 ? '' : ' single' %>">
      <div class="gallery-stage" data-zoom>
        <img src="<%= imageUrl(product) %>" alt="<%= product.name %>" data-gallery-main fetchpriority="high">
        <div class="badges">
          <% if (promo) { %><span class="badge badge-promo">-<%= Math.round((1 - product.price / product.old_price) * 100) %>%</span><% } %>
          <% if (!product.available) { %><span class="badge badge-out">Épuisé</span><% } %>
        </div>
      </div>
      <% if (product.images.length > 1) { %>
        <div class="thumbs">
          <% product.images.forEach((img, i) => { %>
            <button type="button" data-gallery-thumb="<%= imageUrl(product, i) %>" class="<%= i === 0 ? 'active' : '' %>" aria-label="Photo <%= i + 1 %>"><img src="<%= imageUrl(product, i) %>" alt=""></button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="product-info hero-anim">
      <p class="eyebrow"><%= product.brand || label(config.categories, product.category) %></p>
      <h1><%= product.name %></h1>
      <div class="price price-lg">
        <strong><%= formatPrice(product.price) %></strong>
        <% if (promo) { %><s><%= formatPrice(product.old_price) %></s><span class="save">Économisez <%= formatPrice(product.old_price - product.price) %></span><% } %>
      </div>
      <div class="product-meta">
        <% if (product.color) { %><span>Couleur : <strong><%= product.color %></strong></span><% } %>
        <span>Rayon : <strong><%= label(config.genders, product.gender) %></strong></span>
        <span class="stock-dot<%= product.available ? '' : ' out' %>"><%= product.available ? 'En stock, prêt à être expédié' : 'Momentanément épuisé' %></span>
      </div>

      <form class="buy" data-add-to-cart data-product-id="<%= product.id %>" data-product-name="<%= product.name %>">
        <fieldset style="margin:0">
          <legend><span>Choisissez votre <%= sizeLabel.toLowerCase() %></span></legend>
          <div class="sizes">
            <% product.sizes.forEach(s => { %>
              <label class="size-pill <%= s.stock === 0 ? 'disabled' : '' %>" title="<%= s.stock === 0 ? 'Épuisé' : s.stock !== null && s.stock <= 2 ? `Plus que ${s.stock}` : 'Disponible' %>">
                <input type="radio" name="size" value="<%= s.size %>" data-stock="<%= s.stock === null ? 10 : s.stock %>" data-known="<%= s.stock === null ? 0 : 1 %>" <%= s.stock === 0 ? 'disabled' : '' %> required>
                <span><%= s.size %></span>
              </label>
            <% }) %>
          </div>
          <p class="stock-hint" data-stock-hint></p>
        </fieldset>
        <div class="buy-row">
          <div class="qty-big">
            <button type="button" data-qty="-1" aria-label="Moins"><%- icon('minus') %></button>
            <input type="number" name="qty" value="1" min="1" max="10" aria-label="Quantité">
            <button type="button" data-qty="1" aria-label="Plus"><%- icon('plus') %></button>
          </div>
          <button class="btn btn-primary btn-lg" data-buy-btn <%= !product.available ? 'disabled' : '' %>>
            <%- icon('bag') %><%= !product.available ? 'Épuisé' : 'Ajouter au panier' %>
          </button>
        </div>
        <% if (config.shop.whatsapp && product.available) { %>
          <a class="btn btn-whatsapp btn-block wa-order" href="https://wa.me/<%= config.shop.whatsapp %>" target="_blank" rel="noopener" data-wa-order data-wa-base="Salam, je souhaite commander : <%= product.name %> (<%= formatPrice(product.price) %>)"><%- icon('whatsapp') %>Commander sur WhatsApp</a>
        <% } %>
        <p class="form-msg" data-cart-msg role="status"></p>
      </form>

      <ul class="assurances">
        <li><%- icon('cash') %><span><strong>Paiement à la livraison</strong><br>Payez en recevant</span></li>
        <li><%- icon('truck') %><span><strong>Livraison 58 wilayas</strong><br>Dès <%= formatPrice(minDesk) %></span></li>
        <li><%- icon('refresh') %><span><strong>Échange sous 7 jours</strong><br>Pas la bonne pointure ?</span></li>
        <li><%- icon('shield') %><span><strong>Qualité vérifiée</strong><br>Avant chaque envoi</span></li>
      </ul>

      <div class="accordion">
        <% if (product.description) { %>
          <details open><summary>Description <%- icon('down') %></summary><div class="acc-body"><%= product.description %></div></details>
        <% } %>
        <details><summary>Livraison <%- icon('down') %></summary><div class="acc-body">Livraison à domicile ou en point relais (stop desk) dans les 58 wilayas. Les frais dépendent de votre wilaya et sont affichés avant de valider la commande.<% if (config.delivery.freeAbove) { %> Livraison offerte dès <%= formatPrice(config.delivery.freeAbove) %> d'achat.<% } %></div></details>
        <details><summary>Paiement & échange <%- icon('down') %></summary><div class="acc-body">Vous payez en espèces à la réception de votre colis. Nous vous appelons avant l'envoi pour confirmer la commande. Pointure trop petite ou trop grande ? Contactez-nous dans les 7 jours pour un échange.</div></details>
      </div>
    </div>
  </div>

  <% if (similar.length) { %>
    <section class="section-lg">
      <div class="section-head" data-reveal><div><p class="eyebrow">Dans le même style</p><h2>Vous aimerez aussi</h2></div></div>
      <div class="grid"><% similar.forEach((p, i) => { %><%- include('partials/product-card', { p, delay: i * 0.07 }) %><% }) %></div>
    </section>
  <% } %>
</div>

<% if (product.available) { %>
<div class="sticky-buy" data-sticky-buy>
  <div><div class="price"><strong><%= formatPrice(product.price) %></strong></div><small class="muted"><%= product.name %></small></div>
  <button class="btn btn-primary" data-sticky-btn><%- icon('bag') %>Ajouter</button>
</div>
<% } %>
<%- include('partials/foot') %>
