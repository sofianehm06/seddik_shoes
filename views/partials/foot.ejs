  </main>
  <footer class="footer">
    <div class="container footer-grid">
      <div>
        <a href="/" class="logo logo-light"><img src="/img/logo.svg" alt="" width="36" height="36"><span class="logo-text"><%= config.shop.name.split(' ')[0] %><em><%= config.shop.name.split(' ').slice(1).join(' ') %></em></span></a>
        <p><%= config.shop.slogan %></p>
        <div class="socials">
          <% if (config.shop.facebook) { %><a href="<%= config.shop.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><%- icon('facebook') %></a><% } %>
          <% if (config.shop.instagram) { %><a href="<%= config.shop.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><%- icon('instagram') %></a><% } %>
          <% if (config.shop.whatsapp) { %><a href="https://wa.me/<%= config.shop.whatsapp %>" target="_blank" rel="noopener" aria-label="WhatsApp"><%- icon('whatsapp') %></a><% } %>
        </div>
      </div>
      <div>
        <h4>Rayons</h4>
        <% config.genders.forEach(g => { %><a href="/boutique?genre=<%= g.slug %>"><%= g.label %></a><% }) %>
        <a href="/boutique?promo=1">Promotions</a>
      </div>
      <div>
        <h4>Aide</h4>
        <a href="/suivi">Suivre ma commande</a>
        <a href="/panier">Mon panier</a>
        <% if (typeof hasStores !== 'undefined' && hasStores) { %><a href="/boutiques">Points de retrait</a><% } %>
      </div>
      <div>
        <h4>Contact</h4>
        <% config.shop.phones.forEach(p => { %><a href="tel:<%= p.replace(/\s/g, '') %>"><%- icon('phone') %><%= p %></a><% }) %>
        <a href="mailto:<%= config.shop.email %>"><%- icon('mail') %><%= config.shop.email %></a>
        <div class="pay-badges"><span>💵 Paiement à la livraison</span><span>🚚 58 wilayas</span></div>
      </div>
    </div>
    <div class="container footer-bottom">
      <span>© <%= new Date().getFullYear() %> <%= config.shop.name %> — Tous droits réservés</span>
      <span>Fait avec soin à <%= config.shop.city %> 🇩🇿</span>
    </div>
  </footer>

  <% if (config.shop.whatsapp) { %>
    <a class="whatsapp-fab" href="https://wa.me/<%= config.shop.whatsapp %>" target="_blank" rel="noopener" aria-label="Nous contacter sur WhatsApp"><%- icon('whatsapp') %></a>
  <% } %>

  <div class="overlay" data-overlay></div>
  <aside class="drawer drawer-left" data-drawer="menu" aria-label="Menu">
    <div class="drawer-head">
      <a href="/" class="logo"><img src="/img/logo.svg" alt="" width="32" height="32"><span class="logo-text"><%= config.shop.name.split(' ')[0] %><em><%= config.shop.name.split(' ').slice(1).join(' ') %></em></span></a>
      <button class="icon-btn" aria-label="Fermer" data-close><%- icon('x') %></button>
    </div>
    <div class="drawer-body">
      <nav class="mobile-nav">
        <% config.genders.forEach(g => { %><a href="/boutique?genre=<%= g.slug %>"><%= g.label %><%- icon('right') %></a><% }) %>
        <a href="/boutique?type=sandales">Sandales<%- icon('right') %></a>
        <a href="/boutique?type=claquettes">Claquettes<%- icon('right') %></a>
        <a href="/boutique?promo=1" style="color: var(--accent-dark)">Promotions<%- icon('right') %></a>
        <a href="/suivi">Suivre ma commande<%- icon('package') %></a>
      </nav>
      <div class="mobile-contact">
        <% config.shop.phones.forEach(p => { %><a href="tel:<%= p.replace(/\s/g, '') %>"><%- icon('phone') %><%= p %></a><% }) %>
        <a href="mailto:<%= config.shop.email %>"><%- icon('mail') %><%= config.shop.email %></a>
      </div>
    </div>
  </aside>
  <aside class="drawer drawer-right" data-drawer="cart" aria-label="Panier">
    <div class="drawer-head">
      <h3><%- icon('bag') %>Mon panier</h3>
      <button class="icon-btn" aria-label="Fermer" data-close><%- icon('x') %></button>
    </div>
    <div class="drawer-body" data-mini-cart></div>
    <div class="drawer-foot" data-mini-foot hidden></div>
  </aside>
  <div class="toast-zone" data-toasts aria-live="polite"></div>

  <script>window.SHOP = <%- JSON.stringify({ freeAbove: config.delivery.freeAbove, currency: config.currency }).replace(/</g, '\\u003c') %>;</script>
  <script src="/js/cart.js?v=3"></script>
  <script src="/js/main.js?v=3"></script>
</body>
</html>
