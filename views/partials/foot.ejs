  </main>
  <footer class="footer">
    <div class="container footer-grid">
      <div>
        <a href="/" class="logo logo-light"><img src="/img/logo.svg" alt="" width="30" height="30"><span><%= config.shop.name %></span></a>
        <p><%= config.shop.slogan %></p>
      </div>
      <div>
        <h4>Rayons</h4>
        <% config.genders.forEach(g => { %><a href="/boutique?genre=<%= g.slug %>"><%= g.label %></a><% }) %>
      </div>
      <div>
        <h4>Aide</h4>
        <a href="/suivi">Suivre ma commande</a>
        <a href="/boutiques">Nos boutiques</a>
        <a href="/panier">Mon panier</a>
      </div>
      <div>
        <h4>Contact</h4>
        <a href="tel:<%= config.shop.phone.replace(/\s/g, '') %>">📞 <%= config.shop.phone %></a>
        <a href="mailto:<%= config.shop.email %>">✉️ <%= config.shop.email %></a>
        <% if (config.shop.facebook) { %><a href="<%= config.shop.facebook %>" rel="noopener" target="_blank">Facebook</a><% } %>
        <% if (config.shop.instagram) { %><a href="<%= config.shop.instagram %>" rel="noopener" target="_blank">Instagram</a><% } %>
      </div>
    </div>
    <div class="container footer-bottom">© <%= new Date().getFullYear() %> <%= config.shop.name %> — Tous droits réservés</div>
  </footer>
  <% if (config.shop.whatsapp) { %>
    <a class="whatsapp" href="https://wa.me/<%= config.shop.whatsapp %>" target="_blank" rel="noopener" aria-label="Nous contacter sur WhatsApp">
      <svg viewBox="0 0 32 32" width="28" height="28" fill="#fff" aria-hidden="true"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7c-2 0-4-.5-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5 1-1.8.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.2 1.3 3.4c.2.2 2.3 3.5 5.6 4.9 2.1.9 2.9 1 4 .8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.6-.4z"/></svg>
    </a>
  <% } %>
  <script src="/js/cart.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
