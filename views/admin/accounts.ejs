<%- include('_head') %>
<h1>Comptes</h1>

<section class="panel">
  <div class="section-head">
    <h2 class="h3">Tes gains — <%= earnings.month %></h2>
    <form class="toolbar inline"><input type="month" name="mois" value="<%= earnings.month %>"><button class="btn btn-ghost">Voir</button></form>
  </div>
  <div class="kpis">
    <div class="kpi"><span>Ventes livrées (<%= earnings.orders %> commandes)</span><strong><%= formatPrice(earnings.sales) %></strong></div>
    <div class="kpi"><span>Tes commissions</span><strong><%= formatPrice(earnings.commission) %></strong></div>
    <div class="kpi"><span>Tes livraisons (<%= earnings.deliveries %>)</span><strong><%= formatPrice(earnings.delivery) %></strong></div>
    <div class="kpi kpi-accent"><span>Total gagné</span><strong><%= formatPrice(earnings.total) %></strong></div>
  </div>
  <p class="muted small">Les ventes de produits sans fournisseur comptent entièrement dans « Tes commissions ».</p>
</section>

<section class="panel">
  <h2 class="h3">À régler avec les fournisseurs</h2>
  <p class="muted small">Commandes <strong>livrées</strong> pas encore réglées. Quand tu as payé (ou été payé), clique sur « Marquer comme réglé ».</p>
  <% if (!accounts.suppliers.length) { %><p class="muted">Tout est à jour 👍</p><% } else { %>
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th>Fournisseur</th><th class="num">Paires</th><th class="num">Ventes</th><th class="num">Encaissé par toi</th><th class="num">Encaissé par lui</th><th class="num">Ta commission</th><th>Solde</th><th></th></tr></thead>
    <tbody>
      <% accounts.suppliers.forEach(a => { %>
        <tr>
          <td><strong><%= a.name %></strong></td>
          <td class="num"><%= a.pairs %></td>
          <td class="num"><%= formatPrice(a.sales) %></td>
          <td class="num"><%= formatPrice(a.collectedByMe) %></td>
          <td class="num"><%= formatPrice(a.collectedBySupplier) %></td>
          <td class="num"><%= formatPrice(a.commission) %></td>
          <td>
            <% if (a.balance > 0) { %><span class="owe">Tu lui dois <strong><%= formatPrice(a.balance) %></strong></span>
            <% } else if (a.balance < 0) { %><span class="owed">Il te doit <strong><%= formatPrice(-a.balance) %></strong></span>
            <% } else { %>Rien<% } %>
          </td>
          <td>
            <form method="post" action="/admin/comptes/<%= a.id %>/regler" data-confirm="Confirmer que le compte avec <%= a.name %> est réglé ?">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm">Marquer comme réglé</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>
</section>

<% if (settlements.length) { %>
<section class="panel">
  <h2 class="h3">Historique des règlements</h2>
  <table class="table">
    <thead><tr><th>Date</th><th>Fournisseur</th><th class="num">Paires</th><th>Montant</th></tr></thead>
    <tbody>
      <% settlements.forEach(s => { %>
        <tr><td><%= s.created_at.slice(0, 16) %></td><td><%= s.supplier_name %></td><td class="num"><%= s.items %></td>
          <td><%= s.amount > 0 ? 'Tu as payé ' + formatPrice(s.amount) : s.amount < 0 ? 'Il t\'a payé ' + formatPrice(-s.amount) : '—' %></td></tr>
      <% }) %>
    </tbody>
  </table>
</section>
<% } %>
<%- include('_foot') %>
