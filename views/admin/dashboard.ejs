<%- include('_head') %>
<h1>Tableau de bord</h1>
<div class="kpis">
  <a class="kpi" href="/admin/commandes?statut=nouvelle"><span>Nouvelles commandes</span><strong><%= stats.newOrders %></strong></a>
  <div class="kpi"><span>Commandes aujourd'hui</span><strong><%= stats.ordersToday %></strong></div>
  <div class="kpi"><span>CA livré ce mois</span><strong><%= formatPrice(stats.revenueMonth) %></strong></div>
  <a class="kpi" href="/admin/produits"><span>Produits en ligne</span><strong><%= stats.products %></strong></a>
</div>
<div class="two-cols">
  <section class="panel">
    <div class="section-head"><h2 class="h3">Dernières commandes</h2><a href="/admin/commandes">Toutes →</a></div>
    <%- include('_orders-table', { orders }) %>
  </section>
  <section class="panel">
    <h2 class="h3">Stock faible</h2>
    <% if (!stats.lowStock.length) { %><p class="muted">Rien à signaler 👍</p><% } %>
    <ul class="low-stock">
      <% stats.lowStock.forEach(s => { %>
        <li><a href="/admin/produits/<%= s.id %>"><%= s.name %></a> — pointure <%= s.size %> : <strong class="<%= s.stock === 0 ? 'danger' : '' %>"><%= s.stock %></strong></li>
      <% }) %>
    </ul>
  </section>
</div>
<%- include('_foot') %>
