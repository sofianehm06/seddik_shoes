<%- include('_head') %>
<div class="section-head"><h1>Fournisseurs</h1><a class="btn btn-primary" href="/admin/fournisseurs/nouveau">+ Nouveau fournisseur</a></div>
<% if (error) { %><p class="alert"><%= error %></p><% } %>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Nom</th><th>Ville</th><th>Téléphone</th><th>Commission par défaut</th><th class="num">Produits</th></tr></thead>
  <tbody>
    <% if (!suppliers.length) { %><tr><td colspan="5" class="muted">Aucun fournisseur pour l'instant.</td></tr><% } %>
    <% suppliers.forEach(s => { %>
      <tr class="clickable" data-href="/admin/fournisseurs/<%= s.id %>">
        <td><a href="/admin/fournisseurs/<%= s.id %>"><%= s.name %></a></td>
        <td><%= s.city %></td>
        <td><%= s.phone %></td>
        <td><%= s.default_commission_type === 'fixed' ? formatPrice(s.default_commission_value) + ' / paire' : s.default_commission_value + ' %' %></td>
        <td class="num"><a href="/admin/produits?fournisseur=<%= s.id %>"><%= s.products %></a></td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<%- include('_foot') %>
