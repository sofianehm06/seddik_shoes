<%- include('_head') %>
<h1>Changer le mot de passe</h1>
<% if (message) { %><p class="success"><%= message %></p><% } %>
<% if (error) { %><p class="alert"><%= error %></p><% } %>
<form method="post" action="/admin/mot-de-passe" class="panel narrow-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Mot de passe actuel<input type="password" name="current" required autocomplete="current-password"></label>
  <label>Nouveau mot de passe<input type="password" name="next" required minlength="8" autocomplete="new-password"></label>
  <label>Confirmer<input type="password" name="confirm" required minlength="8" autocomplete="new-password"></label>
  <button class="btn btn-primary">Enregistrer</button>
</form>
<%- include('_foot') %>
