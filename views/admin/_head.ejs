<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> | Admin <%= config.shop.name %></title>
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin">
  <% if (csrf) { %>
  <header class="admin-header">
    <a href="/admin" class="logo logo-light"><img src="/img/logo.svg" alt="" width="28" height="28"><span>Admin</span></a>
    <nav>
      <a href="/admin" class="<%= path === '/admin' ? 'active' : '' %>">Tableau de bord</a>
      <a href="/admin/commandes" class="<%= path.startsWith('/admin/commandes') ? 'active' : '' %>">Commandes</a>
      <a href="/admin/a-preparer" class="<%= path.startsWith('/admin/a-preparer') ? 'active' : '' %>">À préparer</a>
      <a href="/admin/produits" class="<%= path.startsWith('/admin/produits') ? 'active' : '' %>">Produits</a>
      <a href="/admin/fournisseurs" class="<%= path.startsWith('/admin/fournisseurs') ? 'active' : '' %>">Fournisseurs</a>
      <a href="/admin/comptes" class="<%= path.startsWith('/admin/comptes') ? 'active' : '' %>">Comptes</a>
      <a href="/admin/boutiques" class="<%= path.startsWith('/admin/boutiques') ? 'active' : '' %>">Points de retrait</a>
      <a href="/admin/mot-de-passe" class="<%= path.startsWith('/admin/mot-de-passe') ? 'active' : '' %>">Mot de passe</a>
      <a href="/" target="_blank">Voir le site ↗</a>
      <form method="post" action="/admin/deconnexion"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Déconnexion</button></form>
    </nav>
  </header>
  <% } %>
  <main class="admin-main">
