<%- include('_head') %>
<div class="section-head"><h1>Produits <small>(<%= total %>)</small></h1><a class="btn btn-primary" href="/admin/produits/nouveau">+ Nouveau produit</a></div>
<form class="toolbar">
  <input type="search" name="q" placeholder="Rechercher…" value="<%= query.q || '' %>">
  <select name="genre"><option value="">Tous les rayons</option><% config.genders.forEach(g => { %><option value="<%= g.slug %>" <%= query.genre === g.slug ? 'selected' : '' %>><%= g.label %></option><% }) %></select>
  <select name="type"><option value="">Tous les types</option><% config.categories.forEach(c => { %><option value="<%= c.slug %>" <%= query.type === c.slug ? 'selected' : '' %>><%= c.label %></option><% }) %></select>
  <button class="btn btn-ghost">Filtrer</button>
</form>
<div class="table-wrap">
<table class="table">
  <thead><tr><th></th><th>Nom</th><th>Rayon</th><th>Type</th><th class="num">Prix</th><th class="num">Stock</th><th>État</th></tr></thead>
  <tbody>
    <% products.forEach(p => { %>
      <tr class="clickable" data-href="/admin/produits/<%= p.id %>">
        <td><img src="<%= imageUrl(p) %>" alt="" class="thumb"></td>
        <td><a href="/admin/produits/<%= p.id %>"><%= p.name %></a><% if (p.featured) { %> ⭐<% } %></td>
        <td><%= label(config.genders, p.gender) %></td>
        <td><%= label(config.categories, p.category) %></td>
        <td class="num"><%= formatPrice(p.price) %></td>
        <td class="num <%= p.totalStock === 0 ? 'danger' : '' %>"><%= p.totalStock %></td>
        <td><%= p.active ? 'En ligne' : 'Masqué' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% if (pages > 1) { %>
  <nav class="pagination"><% for (let i = 1; i <= pages; i++) { %><a href="?<%= new URLSearchParams({ ...query, page: i }) %>" class="<%= i === page ? 'active' : '' %>"><%= i %></a><% } %></nav>
<% } %>
<%- include('_foot') %>
