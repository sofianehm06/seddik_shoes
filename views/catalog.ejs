<%- include('partials/head') %>
<%
  const current = { genre: filters.gender, type: filters.category, pointure: filters.size, q: filters.q, min: filters.min, max: filters.max, promo: filters.promo ? '1' : '', tri: filters.sort };
  const link = (changes) => {
    const params = new URLSearchParams();
    for (const [k, v] of Object.entries({ ...current, ...changes })) if (v) params.set(k, v);
    const s = params.toString();
    return '/boutique' + (s ? '?' + s : '');
  };
  const active = [];
  if (filters.gender) active.push([label(config.genders, filters.gender), { genre: '' }]);
  if (filters.category) active.push([label(config.categories, filters.category), { type: '' }]);
  if (filters.size) active.push(['Pointure ' + filters.size, { pointure: '' }]);
  if (filters.q) active.push(['« ' + filters.q + ' »', { q: '' }]);
  if (filters.min) active.push(['Dès ' + formatPrice(filters.min), { min: '' }]);
  if (filters.max) active.push(["Jusqu'à " + formatPrice(filters.max), { max: '' }]);
  if (filters.promo) active.push(['En promotion', { promo: '' }]);
%>
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb"><a href="/">Accueil</a> <%- icon('right') %> <span>Boutique</span></nav>
    <h1><%= title %></h1>
  </div>
</section>

<div class="container section">
  <div class="catalog">
    <aside class="filters" data-filters>
      <form action="/boutique">
        <h3><%- icon('sliders') %>Filtrer
          <button type="button" class="icon-btn filters-toggle" style="margin-left:auto" aria-label="Fermer" data-filters-close><%- icon('x') %></button>
        </h3>
        <% if (filters.q) { %><input type="hidden" name="q" value="<%= filters.q %>"><% } %>
        <% if (filters.sort) { %><input type="hidden" name="tri" value="<%= filters.sort %>"><% } %>
        <div class="filter-group">
          <label>Rayon
            <select name="genre"><option value="">Tous les rayons</option>
              <% config.genders.forEach(g => { %><option value="<%= g.slug %>" <%= filters.gender === g.slug ? 'selected' : '' %>><%= g.label %></option><% }) %>
            </select>
          </label>
          <label style="margin-bottom:0">Type
            <select name="type"><option value="">Tous les types</option>
              <% config.categories.forEach(c => { %><option value="<%= c.slug %>" <%= filters.category === c.slug ? 'selected' : '' %>><%= c.label %></option><% }) %>
            </select>
          </label>
        </div>
        <% if (sizes.length) { %>
        <fieldset class="filter-group">
          <legend>Pointure</legend>
          <div class="size-filter">
            <% sizes.forEach(s => { %>
              <label class="size-pill"><input type="radio" name="pointure" value="<%= s %>" <%= filters.size === s ? 'checked' : '' %>><span><%= s %></span></label>
            <% }) %>
          </div>
        </fieldset>
        <% } %>
        <div class="filter-group">
          <div class="row">
            <label style="margin-bottom:0">Prix min<input type="number" name="min" min="0" step="100" value="<%= filters.min %>" placeholder="0"></label>
            <label style="margin-bottom:0">Prix max<input type="number" name="max" min="0" step="100" value="<%= filters.max %>" placeholder="∞"></label>
          </div>
        </div>
        <div class="filter-group">
          <label class="check" style="margin:0"><input type="checkbox" name="promo" value="1" <%= filters.promo ? 'checked' : '' %>> En promotion seulement</label>
        </div>
        <button class="btn btn-primary btn-block">Appliquer les filtres</button>
        <a class="reset" href="/boutique">Réinitialiser</a>
      </form>
    </aside>

    <div>
      <div class="catalog-bar">
        <div style="display:flex;gap:.8rem;align-items:center">
          <button class="btn btn-ghost filters-toggle" data-filters-toggle><%- icon('sliders') %>Filtres<% if (active.length) { %> (<%= active.length %>)<% } %></button>
          <span class="count"><%= total %> article<%= total > 1 ? 's' : '' %></span>
        </div>
        <form class="sort-form" action="/boutique">
          <% for (const [k, v] of Object.entries(current)) { if (v && k !== 'tri') { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% } } %>
          <select name="tri" aria-label="Trier" data-autosubmit>
            <option value="recent" <%= !filters.sort || filters.sort === 'recent' ? 'selected' : '' %>>Nouveautés</option>
            <option value="prix-asc" <%= filters.sort === 'prix-asc' ? 'selected' : '' %>>Prix croissant</option>
            <option value="prix-desc" <%= filters.sort === 'prix-desc' ? 'selected' : '' %>>Prix décroissant</option>
            <option value="nom" <%= filters.sort === 'nom' ? 'selected' : '' %>>Nom (A → Z)</option>
          </select>
        </form>
      </div>
      <% if (active.length) { %>
        <div class="active-filters">
          <% active.forEach(([txt, change]) => { %><a href="<%= link({ ...change, page: '' }) %>"><%= txt %><%- icon('x') %></a><% }) %>
        </div>
      <% } %>
      <% if (!products.length) { %>
        <div class="empty">
          <%- icon('search', 'muted') %>
          <h3 style="margin-top:.8rem">Aucun produit trouvé</h3>
          <p class="muted">Essayez d'enlever un filtre ou de chercher un autre mot.</p>
          <a class="btn btn-primary" href="/boutique">Voir tous les produits</a>
        </div>
      <% } else { %>
        <div class="grid"><% products.forEach((p, i) => { %><%- include('partials/product-card', { p, delay: (i % 3) * 0.06 }) %><% }) %></div>
        <% if (pages > 1) { %>
          <nav class="pagination">
            <% for (let i = 1; i <= pages; i++) { %><a href="<%= link({ page: i }) %>" class="<%= i === page ? 'active' : '' %>"><%= i %></a><% } %>
          </nav>
        <% } %>
      <% } %>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
