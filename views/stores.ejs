<%- include('partials/head') %>
<div class="container section">
  <h1>Points de retrait</h1>
  <p class="muted">Retirez gratuitement votre commande dans l'un de ces points.</p>
  <div class="stores">
    <% stores.forEach(s => { %>
      <div class="store">
        <h3><%= s.name %></h3>
        <p><%- icon('pin') %><%= s.address %></p>
        <% if (s.hours) { %><p><%- icon('clock') %><%= s.hours %></p><% } %>
        <% if (s.phone) { %><p><%- icon('phone') %><a href="tel:<%= s.phone.replace(/\s/g, '') %>"><%= s.phone %></a></p><% } %>
        <% if (s.map_url) { %><p><a href="<%= s.map_url %>" target="_blank" rel="noopener">Voir sur la carte →</a></p><% } %>
      </div>
    <% }) %>
  </div>
</div>
<%- include('partials/foot') %>
